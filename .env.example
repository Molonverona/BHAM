# BHAM – Environment variables template
# Copy to .env and edit as needed

APP_NAME=BHAM – BACS Help Auto Mapper
APP_VERSION=0.9.1
DEBUG=false

HOST=0.0.0.0
PORT=8765

# Modbus RTU defaults
MODBUS_DEFAULT_BAUDRATES=[9600,19200,38400,115200]
MODBUS_DEFAULT_PARITIES=["N","E","O"]
MODBUS_TIMEOUT=0.5
MODBUS_FAST_TIMEOUT=0.12

# Modbus TCP
MODBUS_TCP_PORT=502
MODBUS_TCP_TIMEOUT=1.0

# BACnet
BACNET_PORT=47808
BACNET_TIMEOUT=3.0

# ARP Sniffer
ARP_SNIFF_DURATION=30.0
ARP_SNIFF_IFACE=
